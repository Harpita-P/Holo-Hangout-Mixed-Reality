TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/twitch/callback
CHATIRL_PORT=8787

# Community Sandbox. The key stays in this local backend and is never sent to Quest.
OPENAI_API_KEY=
# Low-cost Structured Outputs model; change this without modifying source.
OPENAI_VOXEL_MODEL=gpt-6-luna
# Use "mock" for deterministic no-credit testing; use "openai" for real viewer builds.
COMMUNITY_SANDBOX_GENERATOR=openai
COMMUNITY_SANDBOX_SESSION_LIMIT=20
COMMUNITY_SANDBOX_REQUEST_LIFETIME_MS=45000

# Optional local QA endpoint. Keep disabled during a real stream.
CHATIRL_ALLOW_DEBUG_COMMANDS=false

# OBS Studio 28+ has obs-websocket built in. Keep authentication enabled.
OBS_ENABLED=false
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
OBS_SCENE_NAME=HoloHangout Live
OBS_NATIVE_CAPTURE_SOURCE_NAME=Quest Capture Feed
OBS_FALLBACK_CAPTURE_SOURCE_NAME=MQDH Cast

# Preferred Quest compositor receiver. The control server starts and monitors it.
QUEST_CAPTURE_ENABLED=true
QUEST_CAPTURE_AUTOSTART=true
# When true, server startup runs adb reverse for ports 8081 and 49152.
# Leave false if the Quest is not normally attached when the server starts;
# the dashboard's Configure USB button performs the same setup on demand.
QUEST_CAPTURE_ADB_AUTOCONFIGURE=false
QUEST_CAPTURE_PORT=49152
QUEST_CAPTURE_OBS_UDP_PORT=49153
QUEST_CAPTURE_STALL_THRESHOLD_MS=3000
CHATIRL_HTTPS_PORT=8081
# FFMPEG_BIN=ffmpeg

# Optional. Leave the source name blank to skip microphone preflight/sync.
OBS_MIC_SOURCE_NAME=
OBS_MIC_SYNC_OFFSET_MS=0
