{
  "name": "holohangout",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node tools/local-setup.mjs",
    "start:holohangout": "node tools/local-launcher.mjs",
    "check": "node tools/local-check.mjs",
    "dev": "iwsdk dev restart --open --foreground",
    "dev:launcher": "iwsdk dev restart --no-open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "server": "node --import tsx server/index.ts",
    "server:watch": "node --watch --import tsx server/index.ts",
    "demo:on": "node --import tsx tools/demo-control.ts on",
    "demo:off": "node --import tsx tools/demo-control.ts off",
    "demo:status": "node --import tsx tools/demo-control.ts status",
    "capture:receiver": "node --import tsx tools/quest-capture-receiver.ts",
    "capture:test": "node --import tsx tools/test-capture-transport.ts",
    "capture:build": "node tools/build-quest-capture.mjs",
    "capture:install": "adb install -r quest-capture/app/build/outputs/apk/debug/app-debug.apk",
    "capture:install:release": "adb install -r release/HoloHangout-Capture.apk",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "typecheck:web": "tsc --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "test": "node --import tsx --test server/**/*.test.ts",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
    "dotenv": "^18.0.9",
    "obs-websocket-js": "^5.0.8",
    "openai": "^7.47.0",
    "three": "npm:super-three@0.185.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0-rc.2",
    "@iwsdk/reference": "1.1.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.2",
    "@meta-quest/metavr": "^1.8.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.5",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
