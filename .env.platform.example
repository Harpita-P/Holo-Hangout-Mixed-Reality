# Hosted backend (Render or another persistent Node host)
HOST=0.0.0.0
PORT=8788
HOLOHANGOUT_PUBLIC_URL=https://api.example.com
HOLOHANGOUT_FRONTEND_ORIGIN=https://example.vercel.app
HOLOHANGOUT_DATA_DIR=.holohangout

# Register exactly this callback in the Twitch developer console.
TWITCH_REDIRECT_URI=https://api.example.com/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Generate independent high-entropy values. Never expose these as VITE_* variables.
HOLOHANGOUT_SESSION_SECRET=
HOLOHANGOUT_TOKEN_KEY=
TWITCH_EVENTSUB_SECRET=

# Vercel frontend variables (configure in Vercel, not on the backend)
# VITE_HOLOHANGOUT_API_URL=https://api.example.com
# VITE_HOLOHANGOUT_WS_URL=wss://api.example.com/ws
